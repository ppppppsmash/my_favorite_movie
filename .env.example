# ---- Required ----
# TMDB API key: https://www.themoviedb.org/settings/api (free)
TMDB_API_KEY=

# Public site URL (no trailing slash). Used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://example.com

# ---- Optional: analytics ----
NEXT_PUBLIC_GA_ID=

# ---- Optional: monetization (everything hides itself until configured) ----
# Google AdSense publisher id, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
# AdSense ad unit slot ids
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_DISPLAY=

# Amazon アソシエイト tag, e.g. yourname-22
NEXT_PUBLIC_AMAZON_TAG=

# Affiliate landing URLs for streaming services (A8.net / ValueCommerce / もしも etc.)
NEXT_PUBLIC_AFF_UNEXT=
NEXT_PUBLIC_AFF_HULU=
NEXT_PUBLIC_AFF_DISNEY=
NEXT_PUBLIC_AFF_DMM=
NEXT_PUBLIC_AFF_ABEMA=
NEXT_PUBLIC_AFF_LEMINO=

# ---- Optional: contact / social ----
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_TWITTER=
